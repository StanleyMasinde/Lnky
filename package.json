{
  "name": "lnky",
  "version": "1.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "vue": "^3.5.30",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tsconfig/node20": "^20.1.9",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/ui": "4.1.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "cypress": "^15.12.0",
    "esbuild": "^0.27.4",
    "eslint-plugin-cypress": "^6.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b",
  "description": "Avoid tracking from websites by removing the tracking ids from the URL",
  "main": "eslint.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanleyMasinde/Lnky.git"
  },
  "keywords": [
    "Vue",
    "Privacy",
    "Free",
    "OSS"
  ],
  "author": "Stanley Masinde",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/StanleyMasinde/Lnky/issues"
  },
  "homepage": "https://github.com/StanleyMasinde/Lnky#readme"
}
