{
  "name": "lnky",
  "version": "1.18.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/node20": "^20.1.10",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.8",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/ui": "4.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^15.21.1",
    "esbuild": "^0.27.7",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-vue": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.8",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.6.0",
  "description": "Avoid tracking from websites by removing the tracking ids from the URL",
  "main": "eslint.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanleyMasinde/Lnky.git"
  },
  "keywords": [
    "Vue",
    "Privacy",
    "Free",
    "OSS"
  ],
  "author": "Stanley Masinde",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/StanleyMasinde/Lnky/issues"
  },
  "homepage": "https://github.com/StanleyMasinde/Lnky#readme"
}
